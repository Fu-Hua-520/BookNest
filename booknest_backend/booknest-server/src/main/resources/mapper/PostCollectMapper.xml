<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.fuhua.booknest.server.mapper.PostCollectMapper">

    <!-- 结果映射依赖 application.yml 中 map-underscore-to-camel-case=true，
         数据库列（snake_case）自动映射到实体属性（camelCase） -->

    <!-- 插入帖子收藏记录 -->
    <insert id="insert" parameterType="com.fuhua.booknest.pojo.entity.PostCollect">
        insert into booknest.`post_collect`(id, post_id, user_id)
        values (#{id}, #{postId}, #{userId})
    </insert>

    <!-- 根据帖子ID与用户ID删除收藏记录 -->
    <delete id="deleteByPostAndUser">
        delete from booknest.`post_collect` where post_id = #{postId} and user_id = #{userId}
    </delete>

    <!-- 根据帖子ID删除该帖下所有收藏记录（级联删除帖子时调用） -->
    <delete id="deleteByPostId">
        delete from booknest.`post_collect` where post_id = #{postId}
    </delete>

    <!-- 根据帖子ID与用户ID查询收藏记录 -->
    <select id="selectByPostAndUser" resultType="com.fuhua.booknest.pojo.entity.PostCollect">
        select * from booknest.`post_collect` where post_id = #{postId} and user_id = #{userId}
    </select>

    <!-- 统计帖子收藏数 -->
    <select id="countByPostId" resultType="int">
        select count(*) from booknest.`post_collect` where post_id = #{postId}
    </select>

    <!-- 我的收藏：先按收藏时间倒序取帖子 ID（供 PageHelper 分页），
         再由 Service 批量回查帖子详情并还原顺序。
         不在这里 join post 表，是为了复用 PostServiceImpl 已有的 toPostVO 组装逻辑 -->
    <select id="listCollectedPostIdsByUser" resultType="java.lang.String">
        select post_id from booknest.`post_collect`
        where user_id = #{userId}
        order by create_time desc
    </select>

    <!-- 用户收藏的全部帖子 ID（不分页，供 Redis 状态缓存冷启动一次性灌入） -->
    <select id="listAllCollectedPostIdsByUser" resultType="java.lang.String">
        select post_id from booknest.`post_collect`
        where user_id = #{userId}
    </select>

</mapper>
