<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.fuhua.booknest.server.mapper.CategoryMapper">

    <!-- 结果映射依赖 application.yml 中 map-underscore-to-camel-case=true，
         数据库列（snake_case）自动映射到实体属性（camelCase） -->

    <!-- 插入新分类 -->
    <insert id="insert" parameterType="com.fuhua.booknest.pojo.entity.Category">
        insert into booknest.`category`(id, name, parent_id, sort_order, description, status)
        values (#{id}, #{name}, #{parentId}, #{sortOrder}, #{description}, #{status})
    </insert>

    <!-- 根据分类ID查询分类 -->
    <select id="selectById" resultType="com.fuhua.booknest.pojo.entity.Category">
        select * from booknest.`category` where id = #{id}
    </select>

    <!-- 查询全部分类 -->
    <select id="listAll" resultType="com.fuhua.booknest.pojo.entity.Category">
        select * from booknest.`category` order by parent_id, sort_order asc
    </select>

    <!-- 更新分类信息 -->
    <update id="update" parameterType="com.fuhua.booknest.pojo.entity.Category">
        update booknest.`category`
        set name = #{name},
            parent_id = #{parentId},
            sort_order = #{sortOrder},
            description = #{description},
            status = #{status}
        where id = #{id}
    </update>

    <!-- 根据分类ID删除分类 -->
    <delete id="deleteById">
        delete from booknest.`category` where id = #{id}
    </delete>

</mapper>
