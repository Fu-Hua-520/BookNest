<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.fuhua.booknest.server.mapper.BookMapper">

    <!-- 结果映射依赖 application.yml 中 map-underscore-to-camel-case=true，
         数据库列（snake_case）自动映射到实体属性（camelCase） -->

    <!-- 插入新书籍 -->
    <insert id="insert" parameterType="com.fuhua.booknest.pojo.entity.Book">
        insert into booknest.`book`(id, title, author, isbn, cover_url, description, publisher, publish_date, rating, rating_count, source, create_time)
        values (#{id}, #{title}, #{author}, #{isbn}, #{coverUrl}, #{description}, #{publisher}, #{publishDate}, #{rating}, #{ratingCount}, #{source}, #{createTime})
    </insert>

    <!-- 根据书籍ID查询书籍 -->
    <select id="selectById" resultType="com.fuhua.booknest.pojo.entity.Book">
        select * from booknest.`book` where id = #{id}
    </select>

    <!-- 根据ISBN查询书籍 -->
    <select id="selectByIsbn" resultType="com.fuhua.booknest.pojo.entity.Book">
        select * from booknest.`book` where isbn = #{isbn}
    </select>

    <!-- 根据书名模糊查询书籍 -->
    <select id="selectByTitle" resultType="com.fuhua.booknest.pojo.entity.Book">
        select * from booknest.`book` where title like concat('%', #{title}, '%')
    </select>

    <!-- 更新书籍信息（选择性更新，只更新非空字段，避免部分更新时置空其他字段） -->
    <update id="update" parameterType="com.fuhua.booknest.pojo.entity.Book">
        update booknest.`book`
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="author != null">author = #{author},</if>
            <if test="isbn != null and isbn != ''">isbn = #{isbn},</if>
            <if test="coverUrl != null">cover_url = #{coverUrl},</if>
            <if test="description != null">description = #{description},</if>
            <if test="publisher != null">publisher = #{publisher},</if>
            <if test="publishDate != null">publish_date = #{publishDate},</if>
            <if test="rating != null">rating = #{rating},</if>
            <if test="ratingCount != null">rating_count = #{ratingCount},</if>
            <if test="source != null">source = #{source},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where id = #{id}
    </update>

    <!-- 根据书籍ID删除书籍 -->
    <delete id="deleteById">
        delete from booknest.`book` where id = #{id}
    </delete>

    <!-- 管理后台：关键字条件查询书籍列表（供 PageHelper 分页） -->
    <select id="list" resultType="com.fuhua.booknest.pojo.entity.Book">
        select * from booknest.`book`
        <where>
            <if test="keyword != null and keyword != ''">
                and title like concat('%', #{keyword}, '%')
            </if>
        </where>
        order by create_time desc
    </select>

</mapper>
