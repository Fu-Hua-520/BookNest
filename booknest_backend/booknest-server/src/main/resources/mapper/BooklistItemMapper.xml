<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.fuhua.booknest.server.mapper.BooklistItemMapper">

    <!-- 结果映射依赖 application.yml 中 map-underscore-to-camel-case=true，
         数据库列（snake_case）自动映射到实体属性（camelCase） -->

    <!-- 插入书单条目 -->
    <insert id="insert" parameterType="com.fuhua.booknest.pojo.entity.BooklistItem">
        insert into booknest.`booklist_item`(id, booklist_id, book_id, sort_order, note)
        values (#{id}, #{booklistId}, #{bookId}, #{sortOrder}, #{note})
    </insert>

    <!-- 批量插入书单条目 -->
    <insert id="batchInsert" parameterType="java.util.List">
        insert into booknest.`booklist_item`(id, booklist_id, book_id, sort_order, note)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.booklistId}, #{item.bookId}, #{item.sortOrder}, #{item.note})
        </foreach>
    </insert>

    <!-- 根据书单ID删除其全部条目 -->
    <delete id="deleteByBooklistId">
        delete from booknest.`booklist_item` where booklist_id = #{booklistId}
    </delete>

    <!-- 根据书单ID查询其条目列表 -->
    <select id="listByBooklistId" resultType="com.fuhua.booknest.pojo.entity.BooklistItem">
        select * from booknest.`booklist_item` where booklist_id = #{booklistId} order by sort_order asc
    </select>

    <!-- 根据条目ID查询书单条目 -->
    <select id="selectById" resultType="com.fuhua.booknest.pojo.entity.BooklistItem">
        select * from booknest.`booklist_item` where id = #{id}
    </select>

    <!-- 根据条目ID删除书单条目 -->
    <delete id="deleteById">
        delete from booknest.`booklist_item` where id = #{id}
    </delete>

</mapper>
