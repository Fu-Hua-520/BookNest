<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.fuhua.booknest.server.mapper.PostTagMapper">

    <!-- 结果映射依赖 application.yml 中 map-underscore-to-camel-case=true，
         数据库列（snake_case）自动映射到实体属性（camelCase） -->

    <!-- 插入帖子标签关联 -->
    <insert id="insert" parameterType="com.fuhua.booknest.pojo.entity.PostTag">
        insert into booknest.`post_tag`(id, post_id, tag_id)
        values (#{id}, #{postId}, #{tagId})
    </insert>

    <!-- 批量插入帖子标签关联 -->
    <insert id="batchInsert" parameterType="java.util.List">
        insert into booknest.`post_tag`(id, post_id, tag_id)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.postId}, #{item.tagId})
        </foreach>
    </insert>

    <!-- 根据帖子ID删除其全部标签关联 -->
    <delete id="deleteByPostId">
        delete from booknest.`post_tag` where post_id = #{postId}
    </delete>

    <!-- 根据帖子ID查询其标签ID列表 -->
    <select id="listTagIdsByPostId" resultType="java.lang.String">
        select tag_id from booknest.`post_tag` where post_id = #{postId}
    </select>

    <!-- 统计使用指定标签的帖子数（删除标签前的引用检查） -->
    <select id="countByTagId" resultType="int">
        select count(*) from booknest.`post_tag` where tag_id = #{tagId}
    </select>

</mapper>
