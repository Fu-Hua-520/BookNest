# BookNest 前端环境变量模板
#
# 用法：复制本文件为 .env.local，再按需修改。
#   cp .env.example .env.local
#
# 加载优先级（Vite 内置，同名时后者覆盖前者）：
#   .env  <  .env.[mode]  <  .env.local  <  .env.[mode].local
# 其中 mode 为 development（npm run dev）或 production（npm run build）。
# .env.local 与 *.local 已在 .gitignore 中，不会提交，适合放本机差异配置。

# ---------------------------------------------------------------------------
# 开发服务器代理目标（仅在 npm run dev 生效，由 vite.config.js 的 server.proxy 读取）
# 改后端端口时改这一行即可，无需动 vite.config.js。
# 注意：它以 VITE_ 开头，因此同样落在「可注入浏览器」的命名空间内。当前前端源码从未引用
#   import.meta.env.VITE_API_TARGET，所以构建产物里看不到它；一旦在组件里引用，值就会被
#   内联进 JS 产物。因此这类变量别放密钥，敏感信息请交给后端或 Nginx。
# 另外它是 Node 侧读取：process.env 读不到 .env 里的值，必须用 loadEnv()。
# ---------------------------------------------------------------------------
VITE_API_TARGET=http://localhost:8080

# ---------------------------------------------------------------------------
# 接口请求前缀（打包进前端代码，浏览器可见，必须以 VITE_ 开头）
# 读取处：src/utils/request.js 与 src/utils/sse.js 的 import.meta.env.VITE_API_BASE
#   开发期：/api 由 Vite 代理转发并剥掉前缀
#   生产期：/api 由 nginx 的 proxy_pass 转发并剥掉前缀
# 两者行为一致，所以默认值 /api 在两个环境都适用。
# ---------------------------------------------------------------------------
VITE_API_BASE=/api
