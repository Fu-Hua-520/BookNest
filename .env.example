# =========================================================
# BookNest 环境变量模板（脱敏示例）
# 使用方式：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 所有敏感值均为占位符 change_me，务必替换为真实密钥，严禁提交真实密钥
# 变量名与 docker-compose.yml、application.yml 三处保持一致
# =========================================================

# ---------- MySQL ----------
# 数据库连接信息（docker-compose 内已用服务名 mysql 覆盖 DB_HOST/DB_PORT，
# 此处默认值用于本地直连开发；DB_NAME 固定为 booknest）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=booknest
DB_USERNAME=root
DB_PASSWORD=change_me

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me
# REDIS_DATABASE=0

# ---------- RabbitMQ ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=booknest
RABBITMQ_PASSWORD=change_me
# RABBITMQ_VHOST=/

# ---------- JWT（密钥务必替换为至少 32 字节的随机串）----------
JWT_USER_SECRET=change_me_please_replace_with_a_32_byte_random_secret_key_001
JWT_USER_TTL=7200000
JWT_USER_TOKEN_NAME=authentication
JWT_ADMIN_SECRET=change_me_please_replace_with_a_32_byte_random_secret_key_002
JWT_ADMIN_TTL=7200000
JWT_ADMIN_TOKEN_NAME=admin-authentication

# ---------- 阿里云 OSS 对象存储（无 MinIO，使用云服务）----------
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=change_me
OSS_ACCESS_KEY_SECRET=change_me
OSS_BUCKET_NAME=change_me

# ---------- AI（P4 阶段启用）----------
# DeepSeek 对话模型（OpenAI 兼容端点 https://api.deepseek.com）
DEEPSEEK_API_KEY=change_me
# 阿里云 DashScope Embedding（text-embedding-v3）
DASHSCOPE_API_KEY=change_me

# ---------- 可选：联网搜索（Tavily，P4 预留）----------
# TAVILY_API_KEY=change_me
